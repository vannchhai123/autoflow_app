# ==============================================================================
# AutoClip Frontend .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build and cache outputs
/.next/
/out/
/build
/dist/
.turbo/

# Testing & Coverage
/coverage

# Environment files and credentials (NEVER commit secrets)
.env*
!.env.example
*.pem
*.key

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Debug and runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# Vercel deployment artifacts
.vercel

# TypeScript & build info
*.tsbuildinfo
next-env.d.ts

# OS metadata
.DS_Store
Thumbs.db

.vercel
